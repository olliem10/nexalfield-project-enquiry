# ---------------------------------------------------------------------------
# NexalField — Website Project Questionnaire
#
# Set these in your Vercel project's Environment Variables.
# Never commit real values to source control.
# ---------------------------------------------------------------------------

# REQUIRED — a Postgres connection string (Neon's free tier is enough).
DATABASE_URL=

# REQUIRED — signs the admin dashboard session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# REQUIRED — the NexalField administrator who can sign in at /dashboard.
# This address (or every address in ADMIN_USERS below) also receives an email
# whenever a new project enquiry is submitted, using whichever mail provider
# is configured below.
ADMIN_EMAIL=ollie@nexalfield.com
ADMIN_NAME=Ollie

# REQUIRED — one of the two below.
# Recommended: a PBKDF2 hash produced by `npm run hash-password -- "your password"`.
ADMIN_PASSWORD_HASH=
# Simpler alternative (the plain password, stored only as an environment variable).
# ADMIN_PASSWORD=

# OPTIONAL — several administrators instead of the single ADMIN_* pair above.
# JSON array, e.g.
# ADMIN_USERS=[{"email":"ollie@nexalfield.com","name":"Ollie","passwordHash":"pbkdf2$..."}]
# ADMIN_USERS=

# ---------------------------------------------------------------------------
# Confirmation email — pick ONE provider. Without either, submissions still
# succeed and the dashboard reports the email as "skipped".
# ---------------------------------------------------------------------------

# Option A: Resend (https://resend.com) — the sending domain must be verified.
RESEND_API_KEY=

# Option B: any SMTP server (including Gmail with an app password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Address the confirmation email is sent from, and where replies should go.
EMAIL_FROM="NexalField <onboarding@nexalfield.com>"
EMAIL_REPLY_TO=nexalfield@gmail.com

# ---------------------------------------------------------------------------
# AI project summaries — optional. Without it, submission still succeeds and
# the summary is marked pending.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only needed for a gateway in front of the API.
# ANTHROPIC_BASE_URL=
# Override the model only if you want something other than the default,
# which is claude-opus-5.
# AI_SUMMARY_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Protects /api/cron/retry, the daily housekeeping job. Vercel sends this
# automatically as `Authorization: Bearer $CRON_SECRET` when it is set.
# ---------------------------------------------------------------------------
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Local development only (`npm run start:local`)
# ---------------------------------------------------------------------------
# If DATABASE_URL points at a local Postgres with no password, set this too —
# otherwise functions fail with `user is required`. It is not needed — and
# must not be set — in production.
PGUSER=postgres
